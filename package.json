    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/request": "^2.48.13"
  },
  "lifeforge": {
    "icon": "tabler:history",
    "category": "Lifestyle"
  },
  "peerDependencies": {
    "@lifeforge/api": "workspace:*",
